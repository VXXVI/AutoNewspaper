# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
# setuptools 打包失败时可能留下的 sdist 暂存目录（如 newspaper_auto-0.2.0/）
/newspaper_auto-*/

# 虚拟环境 / 工具缓存
.venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# 前端测试（jsdom）依赖：仅开发用，不入库。
# package.json / package-lock.json 位于 tests/frontend/（有意入库，仅供该目录的 jsdom 测试）。
node_modules/

# macOS
.DS_Store
._*

# 编辑器
.vscode/
.idea/

# 运行产物：hits/（报告与历史命中）与 state/（增量状态、看板配置与任务历史）。
# 这些文件由工具在运行时自动重建，且每天被 CI 整体重写 —— 入库会造成巨大 diff、
# 无限增长，并引发并发冲突。数据改由 scan.yml 推送/恢复到专用的 data 分支，
# main 不再接受任何运行产物（见 .github/workflows/scan.yml 与 README「运行数据」）。
hits/
state/

# 配置例外：papers.custom.json 位于项目根，是有意入库的配置（见 README「自定义报社」）。
# 注意：state/ 整体已被忽略（含 web_config.json / tasks.json / 锁文件与临时文件）。

# 原子写入/跨进程提交的短命临时文件（崩溃残留也不应被提交）。
/.papers.custom.json.*.tmp

# 运行日志
logs/

# 本机看板 / CLI 的默认导出产物
/exports/
